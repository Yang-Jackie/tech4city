# Fastest local demo: in-memory storage and deterministic fake analysis.
TECH4CITY_STORAGE=memory
TECH4CITY_ANALYZER=fake
TECH4CITY_WORKER_ENABLED=true
TECH4CITY_WORKER_POLL_SECONDS=0.25

# Local Layer 1 (installation and operation: ../README.md).
TECH4CITY_LAYER1_MODEL_DIR=Layer/cyberbully-roblox-pii-lora-synbullying/best_model
TECH4CITY_LAYER1_PIPELINE_VERSION=layer1-roblox-pii-lora-synbullying-v1
# Set TECH4CITY_ANALYZER=layer1 to enable it.
# Set HF_TOKEN only when approved access is required; never commit the token.

# Gated Layer 1 -> Layer 2 placeholder for real users. Layer 2 returns an
# explicit skipped result with no score until a real-user cold start is approved.
TECH4CITY_LAYER2_PIPELINE_VERSION=layer2-skipped-real-user-v1
# Set TECH4CITY_ANALYZER=layer1-layer2 to exercise the gate and placeholder.

# Layer 3 uses the existing OpenAI-backed conversation-analysis contract.
TECH4CITY_LAYER3_MODEL=chatgpt-answer
TECH4CITY_LAYER3_PIPELINE_VERSION=layer3-chatgpt-answer-v1
# OPENAI_API_KEY=replace-with-your-own-key
# Set TECH4CITY_ANALYZER=layer3 for a direct lightweight test, or
# TECH4CITY_ANALYZER=layer1-layer2-layer3 for the gated real-user pipeline.

# Optional persistent MongoDB. Uncomment these lines, choose one URL-safe local
# password, and use the same value in MONGO_ROOT_PASSWORD and MONGODB_URI.
# MONGO_ROOT_USERNAME=tech4city_dev
# MONGO_ROOT_PASSWORD=replace-with-your-own-local-password
# TECH4CITY_STORAGE=mongodb
# MONGODB_URI=mongodb://tech4city_dev:replace-with-your-own-local-password@127.0.0.1:27017/?authSource=admin
# MONGODB_DATABASE=tech4city
