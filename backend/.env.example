# Fastest local demo: in-memory storage and deterministic fake analysis.
DETECTIVES_STORAGE=memory
DETECTIVES_ANALYZER=fake
DETECTIVES_WORKER_ENABLED=true
DETECTIVES_WORKER_POLL_SECONDS=0.25

# Local Layer 1 (installation and operation: ../README.md).
DETECTIVES_LAYER1_MODEL_DIR=Layer/cyberbully-roblox-pii-lora-synbullying/best_model
DETECTIVES_LAYER1_PIPELINE_VERSION=layer1-roblox-pii-lora-synbullying-v1
# Set DETECTIVES_ANALYZER=layer1 to enable it.
# Set HF_TOKEN only when approved access is required; never commit the token.

# Gated Layer 1 -> Layer 2 placeholder for real users. Layer 2 returns an
# explicit skipped result with no score until a real-user cold start is approved.
DETECTIVES_LAYER2_PIPELINE_VERSION=layer2-skipped-real-user-v1
# Set DETECTIVES_ANALYZER=layer1-layer2 to exercise the gate and placeholder.

# Layer 3 uses the existing OpenAI-backed conversation-analysis contract.
DETECTIVES_LAYER3_MODEL=chatgpt-answer
DETECTIVES_LAYER3_PIPELINE_VERSION=layer3-chatgpt-answer-v1
# OPENAI_API_KEY=replace-with-your-own-key
# Set DETECTIVES_ANALYZER=layer3 for a direct lightweight test, or
# DETECTIVES_ANALYZER=layer1-layer2-layer3 for the gated real-user pipeline.

# Optional persistent MongoDB. Uncomment these lines, choose one URL-safe local
# password, and use the same value in MONGO_ROOT_PASSWORD and MONGODB_URI.
# MONGO_ROOT_USERNAME=detectives_dev
# MONGO_ROOT_PASSWORD=replace-with-your-own-local-password
# DETECTIVES_STORAGE=mongodb
# MONGODB_URI=mongodb://detectives_dev:replace-with-your-own-local-password@127.0.0.1:27017/?authSource=admin
# MONGODB_DATABASE=detectives
