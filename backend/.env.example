# Copy this file to backend/.env and replace both password placeholders with
# the same URL-safe development password. Never commit backend/.env.
MONGO_ROOT_USERNAME=tech4city_dev
MONGO_ROOT_PASSWORD=replace-with-a-random-url-safe-password

TECH4CITY_STORAGE=mongodb
MONGODB_URI=mongodb://tech4city_dev:replace-with-a-random-url-safe-password@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=tech4city
TECH4CITY_ANALYZER=fake
TECH4CITY_WORKER_ENABLED=true
TECH4CITY_WORKER_POLL_SECONDS=0.25
TECH4CITY_LAYER1_MODEL_DIR=../Layer/cyberbully-roblox-pii-lora-synbullying/best_model
TECH4CITY_LAYER1_PIPELINE_VERSION=layer1-roblox-pii-lora-synbullying-v1
# The referenced base model is gated. Set HF_TOKEN only in backend/.env after access is approved.
# HF_TOKEN=replace-with-an-approved-read-token
