# Obtain these values from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Relative paths are resolved from the repository root.
TDJSON_PATH=telegram/.tdlib-build/install/bin/tdjson.dll
TDLIB_DATABASE_DIR=telegram/.tdlib/production/database
TDLIB_FILES_DIR=telegram/.tdlib/production/files
TDLIB_LOG_DIR=telegram/.tdlib/production/logs

# The CLI generates and persists this value on first run if it is empty.
TDLIB_DATABASE_ENCRYPTION_KEY=

# This standalone utility is configured for the real Telegram account.
TDLIB_USE_TEST_DC=false

